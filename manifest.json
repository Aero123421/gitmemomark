{
  "manifest_version": 3,
  "name": "GitMemoMark",
  "version": "0.1.0",
  "homepage_url": "https://github.com/Aero123421/gitmemomark",
  "description": "X のポストや Web ページを、あなたの GitHub リポジトリにフォルダ分けして保存するブックマーク拡張機能。Jev による自動仕分けにも対応。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub に保存",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.typesafe.ai/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/x.js"],
      "css": ["src/content/x.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-save": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "ダイアログなしで今のページをすぐ保存"
    }
  }
}
